# Servidor
PORT=3001
NODE_ENV=development

# Banco de dados (SQLite via Prisma)
DATABASE_URL="file:./dev.db"

# JWT Secrets (use chaves longas e aleatórias em produção)
JWT_ACCESS_SECRET="seu_jwt_access_secret_aqui_mude_em_producao"
JWT_REFRESH_SECRET="seu_jwt_refresh_secret_aqui_mude_em_producao"

# Tempo de expiração dos tokens
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# URL do frontend (para CORS)
FRONTEND_URL="http://localhost:5174"
PUBLIC_SITE_URL="http://localhost:5173"

# Upload de arquivos
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880

# URL base da API (usada na geração de QR codes)
API_BASE_URL="http://localhost:3001"
